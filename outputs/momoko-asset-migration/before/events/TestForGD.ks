*start
; GD用・自由記述チュートリアル。事前のタネ取得は不要。
; 入力文は seed_answer の answer_echo 設定で表示する。
[resetlaypos]
[bg_show storage="教室昼" bg_x="0.5" bg_y="0.5" bg_zoom="1.0"]
[bgm bgm="MokLap1.mp3" volume="0.55" loop="true" fade="0.0"]
[chara_show name="増田" torso="MST_T00_ARM_0005" eye="MST_F00_EYE_0006" mouth="MST_F00_MOU_0016" brow="MST_F00_BRO_0005" effect="" blink="true" x="0.25" y="1.0" size="2.3" fade="0"]
[chara_show name="桃子" torso="MMK_T00_ARM00_CLO00" eye="MMK_F00_EYE00_00" mouth="MMK_F00_MOU04_00" brow="MMK_F00_BRO00_00" cheek="MMK_F00_CHE04_00" effect="" blink="true" x="0.75" y="1.0" size="2.3" fade="0"]
	//桃子//
	「えへへ・・・」
	//純一//
	「最近だって、家族全員で旅行に行ってなかったっけ？」
	//桃子//
	「うん！熱海に行ってたよ～。」
	「妹の中学入学のお祝いで！」
	//増田//
	「うおぉ！熱海か、いいなぁー！」
	「そっかー、杏ちゃんももう中学生かぁ～。」
	「どうだった？楽しかった！？」
	//桃子//
	「楽しかった～！」
	「お小遣いでお土産い～っぱい買って、はしゃいじゃった！」
	//純一//
	「あはは、存分に楽しんだみたいだね。」
	//桃子//
	「うん！」
	「それで、私からはワンピースをプレゼントしたの！」
	「喜んでくれて良かった～。」
	//増田//
	「なんて素敵なお姉ちゃん・・・」
	//純一//
	「いい思い出になったな。」
	//桃子//
	「えへへ・・・」
	//増田//
	「いいないいな、俺たちも思い出ほ～し～い～！」
	//純一//
	「うおっ！？」
	「なんだよいきなり・・・」
	//増田//
	「そうだ！！」
	「今度の休み、３人でディズニーランド行こうぜ！？」
[chara_shift name="桃子" effect="MMK_E00_01" fade="0.15"]
	//桃子//
	「え、ディズニー？」
	//純一//
	「あ～、長らく行ってないな。」
	「久し振りに遊びに行くか、舞浜まで。」
	//増田//
	「お～！流石相棒！！」
	「桃子も来るよな、今月辺りでどう？」
	//桃子//
	「え、え～と・・・」
	「う～んと・・・」
	「・・・まあ？」
	//増田//
	「ん？」
	//純一//
	「（・・・）」
	「（なんだ、この歯切れの悪さは。）」
	「（いつもなら誰よりもノリノリなのに。）」
	「（・・・何か事情がありそうだぞ。）」
	「（さっき桃子の言っていたこと。）」
	「（そしてディズニーランドの安くない入園料。）」
	「（この事実から類推するとわかることは――）」
[scroll-stop]
[seed_answer turning_point="MOMOKO_GD_MONEY" prompt="桃子が誘いを渋る理由は？"]

[if condition="MOMOKO_GD_MONEY_RESULT==correct"]
	//純一//
	「――そうだろ？」
	//桃子//
	「う・・・」
	「実はそうなんだよね～。」
	//増田//
	「確かに、家族旅行で散財したって言ってたしなぁ。」
	//桃子//
	「えへへ・・・」
	「ﾁｮｯﾄﾀﾞｹ、使いすぎちゃった。」
	//純一//
	「まあ、そういうことだ。」
	「桃子の懐が温まるまで、待ってもいいんじゃないか？」
	//桃子//
	「うぅ～、それで大丈夫？」
	//増田//
	「何言ってんだい、あたぼうよ！」
	「この３人で行くことに意味があるんだから！」
	//純一//
	「だよな。」
[chara_shift name="桃子" effect="" fade="0.15"]
	//桃子//
	「・・・！」
	「ふたりとも、ありがとっ！」
[endif]

; 条件評価器は複合比較に未対応なので、不正解と微妙を別ブロックにする。
[if condition="MOMOKO_GD_MONEY_RESULT==incorrect"]
	//純一//
	「（ん、いや、これはちょっと違う気がするな。）」
	「（もう一度状況を整理しよう。）」
	「桃子は特別多くない小遣いで日々やりくりしている。」
	「しかし、最近はお土産やプレゼントで出費が増えた。」
	「そこに、近日中のディズニーランドへの誘い。」
	「あの行楽地は入園料が安くない。」
	「舞浜までの交通費も馬鹿にならない。」
	「となると、桃子が誘いを渋る理由としてわかることは――」
[scroll-stop]
[seed_retry]
[endif]

[if condition="MOMOKO_GD_MONEY_RESULT==borderline"]
	//純一//
	「（ん、いや、これはちょっと違う気がするな。）」
	「（もう一度状況を整理しよう。）」
	「桃子は特別多くない小遣いで日々やりくりしている。」
	「しかし、最近はお土産やプレゼントで出費が増えた。」
	「そこに、近日中のディズニーランドへの誘い。」
	「あの行楽地は入園料が安くない。」
	「舞浜までの交通費も馬鹿にならない。」
	「となると、桃子が誘いを渋る理由としてわかることは――」
[scroll-stop]
[seed_retry]
[endif]
