[chara_shift name="増田" torso="MST_T00_ARM_0004" eye="MST_F00_EYE_0001" mouth="MST_F00_MOU_0004" brow="MST_F00_BRO_0005" effect="" x="0.725" y="1.0" fade="0.3"]
	//増田//
