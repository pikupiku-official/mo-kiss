[chara_shift name="杏" template="杏おちゃらけ2" torso="ANZ_T00_0001" eye="ANZ_F00_EYE_0002" mouth="ANZ_F00_MOU_0011" brow="ANZ_F00_BRO_0001" cheek="ANZ_F00_CHE_0001" fade="0.15"]
	//杏//
